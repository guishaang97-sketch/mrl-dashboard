# Copy this file to .env.local and fill in your values.
# Find both under Supabase dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Web push public key (safe to expose in the frontend — this is the public
# half of the VAPID key pair; the private half stays server-side only, as
# a Supabase Edge Function secret).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
